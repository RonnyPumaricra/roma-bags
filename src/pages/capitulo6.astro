---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Capítulo 06: Gestión del Alcance">
<style>
    .chapter-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0 2rem; align-items: center; }
    .chapter-toolbar .ct-btn { display: inline-flex; align-items: center; justify-content: center; padding: .8rem 1.1rem; border-radius: 999px; border: 1px solid rgba(15,23,42,.12); background: #fff; color: var(--b); font-weight: 700; text-decoration: none; box-shadow: 0 8px 22px rgba(15,23,42,.08); transition: transform .18s ease, background .18s ease, border-color .18s ease; }
    .chapter-toolbar .ct-btn:hover { transform: translateY(-1px); border-color: #2563eb; background: #eff6ff; }
    .chapter-toolbar .ct-btn-primary { background: linear-gradient(135deg,#1d4ed8,#2563eb); color: #fff; border-color: transparent; }
    .chapter-toolbar .ct-btn-primary:hover { background: linear-gradient(135deg,#1e40af,#1d4ed8); }
    .dic-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(300px,1fr)); gap: 1.2rem; margin-top: 1.6rem; counter-reset: dictionary-entry; }
    .dic-grid .dic-item { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; box-shadow: 0 16px 34px rgba(15,23,42,.08); padding: 1.35rem 1.35rem 25px; position: relative; counter-increment: dictionary-entry; height: auto; min-height: 100%; display: flex; flex-direction: column; }
    .dic-grid .dic-item::before { content: counter(dictionary-entry, decimal) "."; position: absolute; top: 1.25rem; right: 1.25rem; font-size: .95rem; font-weight: 800; color: #2563eb; background: rgba(59,130,246,.12); padding: .35rem .75rem; border-radius: 999px; }
    .dic-grid .dic-item h5 { margin: 0 0 .75rem; font-size: 1.02rem; color: #1d4ed8; letter-spacing: .02em; padding-right: 4rem; width: 100%; display: flex; align-items: center; justify-content: flex-start; }
    .dic-grid .dic-item p { margin: .45rem 0; line-height: 1.7; color: #334155; font-size: .94rem; }
    .dic-grid .dic-item p strong { color: #0f172a; }
    .dic-grid .dic-item .meta { display: grid; grid-template-columns: 1fr; gap: .4rem; margin: .8rem 0 0; font-size: .88rem; color: #475569; }
    .dic-grid .dic-item .meta span { display: inline-flex; align-items: center; gap: .4rem; background: #eef2ff; padding: .28rem .65rem; border-radius: 999px; border: 1px solid #dbeafe; }
    .dic-section-header { margin: 2rem 0 .9rem; padding: .95rem 1rem; border-radius: 16px; background: linear-gradient(135deg,#e0f2fe,#dbeafe); color: #1e3a8a; border: 1px solid #bae6fd; font-weight: 700; box-shadow: inset 0 1px 0 rgba(255,255,255,.8); }
    .dic-section-header span { display: inline-flex; align-items: center; gap: .5rem; }
    .dic-section-header small { display: block; font-size: .85rem; color: #475569; margin-top: .35rem; }
  </style>
<style>
    .new-table {width:100%;border-collapse:collapse;font-size:.86rem;min-width:740px}
    .new-table th,.new-table td{padding:.55rem .7rem;text-align:left;border-bottom:1px solid #e2e8f0;vertical-align:top}
    .new-table th{background:#e0e7ff;color:#1e3a8a;position:sticky;top:0}
    .new-scroll{overflow-x:auto;margin:1rem 0 1.5rem}
    .new-box{background:#fff;border:1px solid #dbeafe;border-radius:18px;padding:1.25rem;margin:1.1rem 0;box-shadow:0 10px 22px rgba(15,23,42,.06)}
    .new-note{background:#eff6ff;border-left:4px solid #2563eb;padding:1rem 1.2rem;border-radius:10px;margin:1.2rem 0}
    .new-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem}
    .new-card{background:#fff;border:1px solid #dbeafe;border-radius:16px;padding:1rem}
    .new-card h4{margin:.2rem 0 .5rem;color:#1e40af}
    .new-card p{margin:.4rem 0;line-height:1.6}
    .new-pill{display:inline-block;background:#faf5ff;color:#7e22ce;border-radius:7px;padding:.1rem .4rem;font-size:.78rem;font-weight:700}
    .new-meta{display:flex;flex-wrap:wrap;gap:1rem;color:#1e40af;font-weight:700}
    #wbs-tree{width:100%;overflow-x:auto;padding:1rem 0 1.25rem;-webkit-overflow-scrolling:touch}
    #wbs-tree .edt-wrap{min-width:1180px;padding:1.35rem;background:#fafbfe;border:1px solid #e2e8f0;border-radius:16px;box-sizing:border-box}
    #wbs-tree .root-node{text-align:center}
    #wbs-tree .root-box{display:inline-block;max-width:60%;padding:.7rem 1.6rem;border-radius:14px;background:linear-gradient(135deg,#183d7c,#1a56b0);box-shadow:0 6px 18px rgba(24,61,124,.3);color:#fff;font-size:.84rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
    #wbs-tree .root-conn{height:36px;position:relative}
    #wbs-tree .root-conn::before{content:"";position:absolute;top:0;left:50%;width:2px;height:18px;background:#94a3b8}
    #wbs-tree .root-conn::after{content:"";position:absolute;top:18px;left:10%;right:10%;height:2px;background:#94a3b8}
    #wbs-tree .lvl1{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;align-items:start}
    #wbs-tree .branch{display:flex;min-width:0;flex-direction:column;align-items:center}
    #wbs-tree .branch-conn{width:2px;height:25px;background:#94a3b8}
    #wbs-tree .cat-node{display:flex;width:100%;min-height:68px;box-sizing:border-box;flex-direction:column;align-items:center;justify-content:center;padding:.65rem .55rem;border:2.5px solid;border-radius:12px;box-shadow:0 3px 8px rgba(0,0,0,.06);text-align:center}
    #wbs-tree .cat-id{font-size:.98rem;font-weight:800}
    #wbs-tree .cat-label{font-size:.78rem;font-weight:700;line-height:1.3}
    #wbs-tree .cat-blue{border-color:#1f5fbf;background:#eff6ff;color:#1f5fbf}
    #wbs-tree .cat-green{border-color:#2c9a44;background:#f0fdf4;color:#2c9a44}
    #wbs-tree .cat-orange{border-color:#f37b21;background:#fff7ed;color:#ea580c}
    #wbs-tree .cat-purple{border-color:#7c4dff;background:#faf5ff;color:#7c4dff}
    #wbs-tree .cat-cyan{border-color:#00a9b7;background:#ecfeff;color:#008b98}
    #wbs-tree .child-conn{width:2px;height:20px;background:var(--branch-color)}
    #wbs-tree .pkg-list{width:100%;overflow:hidden;border:2px solid var(--branch-color);border-radius:10px;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.05)}
    #wbs-tree .pkg-header{padding:.4rem;background:var(--branch-color);color:#fff;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-align:center;text-transform:uppercase}
    #wbs-tree .pkg-item{padding:.65rem .6rem;border-bottom:1px solid #e2e8f0;background:#fff;color:#334155;font-size:.71rem;line-height:1.4}
    #wbs-tree .pkg-item:last-child{border-bottom:0}
    #wbs-tree .pkg-title{display:flex;gap:.4rem;align-items:flex-start;font-weight:700;color:#1e293b}
    #wbs-tree .pid{flex:0 0 auto;padding:.12rem .3rem;border-radius:4px;background:#e2e8f0;color:#475569;font-size:.62rem;font-weight:800}
    #wbs-tree .pkg-meta{display:grid;gap:.22rem;margin:.45rem 0 0;padding-top:.4rem;border-top:1px dashed #dbe2ea;color:#64748b}
    #wbs-tree .pkg-meta strong{color:#475569}
    #wbs-tree .branch-blue{--branch-color:#1f5fbf}
    #wbs-tree .branch-green{--branch-color:#2c9a44}
    #wbs-tree .branch-orange{--branch-color:#f37b21}
    #wbs-tree .branch-purple{--branch-color:#7c4dff}
    #wbs-tree .branch-cyan{--branch-color:#00a9b7}
    #wbs-tree .scroll-hint{display:none}
    @media(max-width:1200px){#wbs-tree .scroll-hint{display:block;position:sticky;left:0;margin:.75rem 0 0;color:#64748b;font-size:.75rem;text-align:center}}
  </style>
<h2>CAPÍTULO 06: Gestión del Alcance (Línea Base del Alcance)</h2><p>Proyecto: 21/09/2026–26/04/2027 · 149 días hábiles · Gates 17/11/2026, 08/03/2027 y 21/04/2027.</p>
<section class="sec" id="trazabilidad"><h3>6.0 Documentación de requisitos y trazabilidad</h3><p>La línea base responde a la gestión fragmentada de información operativa y comercial. La evidencia del Anexo 2.5 indica que 70,8 % de registros de despacho de 2026 carecen de información financiera o logística. Los requisitos se validan en el diagnóstico programado entre septiembre y octubre de 2026.</p><div class="new-scroll"><table class="new-table"><thead><tr><th>ID</th><th>Requisito</th><th>Causa</th><th>Paquete EDT</th><th>Actividades</th><th>Aceptación</th></tr></thead><tbody><tr><td>REQ-01</td><td>Fuente única de inventario y ventas</td><td>CI 1.1 / CI 1.2</td><td>EDT-1.3.03 / EDT-1.4.03</td><td>1.3.16, 1.3.21, 1.4.10, 1.5.13</td><td>Registro consistente y fuente oficial Odoo tras el corte.</td></tr><tr><td>REQ-02</td><td>Consulta móvil de stock</td><td>CI 1.1</td><td>EDT-1.3.03</td><td>1.3.18–1.3.19</td><td>Consulta cronometrada en menos de 2 minutos.</td></tr><tr><td>REQ-03</td><td>Conciliación semanal ágil</td><td>CI 2.1</td><td>EDT-1.4.04 / EDT-1.5.01</td><td>1.4.17–1.4.18, 1.5.16–1.5.17</td><td>Comparar tiempo real frente a línea base de 1 día semanal.</td></tr><tr><td>REQ-04</td><td>Despacho completo y trazable</td><td>CI 2.3 / ED 2</td><td>EDT-1.3.02 / EDT-1.4.04</td><td>1.3.10–1.3.11, 1.4.17–1.4.19</td><td>Registrar y verificar ventas, stock y despacho con casos UAT; tras la salida en vivo, reducir a 5 % o menos los registros incompletos de la muestra revisada.</td></tr><tr><td>REQ-05</td><td>Reportes móviles de stock, calidad de datos y rentabilidad operativa</td><td>CI 3.1 / ED 3</td><td>EDT-1.5.01</td><td>1.5.1–1.5.4, 1.5.16</td><td>Gerencia valida cifras, fuentes y acceso por rol.</td></tr><tr><td>REQ-06</td><td>Operación en celulares y dos talleres</td><td>CI 1.2</td><td>EDT-1.3.01 / EDT-1.4.04</td><td>1.3.4, 1.4.14–1.4.15, 1.4.21</td><td>Pruebas de conectividad y flujo por ubicación.</td></tr><tr><td>REQ-07</td><td>Coexistencia controlada y corte del piloto</td><td>CI 2.2</td><td>EDT-1.3.03 / EDT-1.5.03</td><td>1.3.20, 1.5.11–1.5.13</td><td>Un responsable de fuente oficial; piloto bloqueado tras salida.</td></tr><tr><td>REQ-08</td><td>Respaldo, seguridad y permisos</td><td>CI 2.2</td><td>EDT-1.3.02 / EDT-1.4.02</td><td>1.3.12–1.3.13, 1.4.5–1.4.6</td><td>Respaldo verificable y acceso probado por rol.</td></tr><tr><td>REQ-09</td><td>Datos depurados, conciliados y preservados</td><td>CI 3.2</td><td>EDT-1.3.02 / EDT-1.4.03</td><td>1.3.14–1.3.15, 1.4.8–1.4.11</td><td>Conteos y saldos conciliados; preservar originales de 2026.</td></tr><tr><td>REQ-10</td><td>Adopción y transferencia de control</td><td>CI 2.3 / CI 3.1</td><td>EDT-1.5.02 / EDT-1.5.04</td><td>1.5.5–1.5.9, 1.5.15–1.5.22</td><td>Capacitación por rol, evidencias de uso y responsables firmados.</td></tr></tbody></table></div><div class="new-note">Los códigos <strong>EDT-</strong> identifican entregables; los códigos 1.1.1–1.5.23 identifican actividades del cronograma. La matriz mantiene ambos separados.</div></section>
<section class="sec" id="definir"><h3>6.1 Enunciado del alcance</h3><div class="new-grid"><div class="new-card"><h4>Incluido</h4><p>Diagnóstico AS-IS/TO-BE, conectividad, base piloto temporal, gobierno y limpieza de datos, Odoo Community para inventario/ventas/despachos, conciliación y migración, pruebas por rol, reportes gerenciales, capacitación, salida a producción, monitoreo y transferencia al Comité de Datos.</p></div><div class="new-card"><h4>Excluido</h4><p>Recuperación de registros perdidos del 2024, contabilidad formal, facturación electrónica, integración SUNAT, e-commerce, automatización de maquinaria y mantenimiento evolutivo posterior al cierre.</p></div></div><h4>Criterios de aceptación por gate</h4><div class="new-grid"><div class="new-card"><h4>Gate 1 · 17/11/2026</h4><p>Conectividad verificada; comité y responsables designados; diccionario, SOP y respaldo aprobados; catálogo depurado; captura piloto y consulta móvil comprobadas; coexistencia con Excel documentada.</p></div><div class="new-card"><h4>Gate 2 · 08/03/2027</h4><p>Odoo en pruebas con datos conciliados, flujo y permisos verificados, UAT firmadas por Ventas, Producción y Gerencia, sin defectos críticos abiertos y plan de corte aprobado.</p></div><div class="new-card"><h4>Gate 3 · 21/04/2027</h4><p>Odoo como fuente oficial, monitoreo y auditoría de calidad, reportes en uso real, capacitación, criterios de aceptación e informe final verificados; conformidad firmada. Archivo administrativo: 26/04/2027.</p></div></div></section>
<section class="sec" id="edt">
  <h3>6.2 Estructura de Desglose del Trabajo (EDT)</h3>
  <p>La EDT se organiza por <strong>entregables</strong>, no por cada acción del cronograma. Sus cinco ramas son 1.1 Dirección y planificación, 1.2 Diagnóstico AS-IS/TO-BE, 1.3 Cimentar, 1.4 Integrar y 1.5 Optimizar y cerrar. Los paquetes siguientes cubren las 92 actividades e hitos y permiten comprobar la regla del 100 %.</p>

  <div id="wbs-tree" aria-label="Árbol de la Estructura de Desglose del Trabajo">
    <div class="edt-wrap">
      <div class="root-node">
        <div class="root-box">1. Transformación Digital Roma Bag's</div>
      </div>
      <div class="root-conn"></div>

      <div class="lvl1">
        <div class="branch branch-blue">
          <div class="branch-conn"></div>
          <div class="cat-node cat-blue"><span class="cat-id">1.1</span><span class="cat-label">Dirección y planificación</span></div>
          <div class="child-conn"></div>
          <div class="pkg-list">
            <div class="pkg-header">Entregables</div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.1.01</span><span>Dirección y líneas base</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.1.1–1.1.4</span><span><strong>Resultado:</strong> Acta firmada, responsables y planes aprobados</span><span><strong>Responsable:</strong> Patrocinador / líder</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.1.02</span><span>Seguimiento y control</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.1.5–1.1.7</span><span><strong>Resultado:</strong> Informes, registro de cambios y seguimiento documentado</span><span><strong>Responsable:</strong> Líder</span></div>
            </div>
          </div>
        </div>

        <div class="branch branch-green">
          <div class="branch-conn"></div>
          <div class="cat-node cat-green"><span class="cat-id">1.2</span><span class="cat-label">Diagnóstico AS-IS/TO-BE</span></div>
          <div class="child-conn"></div>
          <div class="pkg-list">
            <div class="pkg-header">Entregables</div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.2.01</span><span>Diagnóstico AS-IS</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.2.1–1.2.5</span><span><strong>Resultado:</strong> Flujo actual y fuentes auditadas</span><span><strong>Responsable:</strong> Analista / Gerencia</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.2.02</span><span>Diseño TO-BE y requisitos</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.2.6–1.2.9</span><span><strong>Resultado:</strong> Requisitos REQ-01–10 y trazabilidad firmada</span><span><strong>Responsable:</strong> Analista / responsables</span></div>
            </div>
          </div>
        </div>

        <div class="branch branch-orange">
          <div class="branch-conn"></div>
          <div class="cat-node cat-orange"><span class="cat-id">1.3</span><span class="cat-label">Cimentar</span></div>
          <div class="child-conn"></div>
          <div class="pkg-list">
            <div class="pkg-header">Entregables</div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.3.01</span><span>Conectividad operativa</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.3.1–1.3.4</span><span><strong>Resultado:</strong> Red y respaldo móvil probados en talleres</span><span><strong>Responsable:</strong> Infraestructura</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.3.02</span><span>Gobierno inicial y calidad</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.3.5–1.3.7, 1.3.10–1.3.15</span><span><strong>Resultado:</strong> Comité, dueños, diccionario, SOP, respaldo y catálogo depurado</span><span><strong>Responsable:</strong> Gerencia / dueños de datos</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.3.03</span><span>Piloto centralizado controlado</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.3.8–1.3.9, 1.3.16–1.3.23</span><span><strong>Resultado:</strong> Modelo mapeado, captura, stock móvil y coexistencia trazable</span><span><strong>Responsable:</strong> Analista / usuarios</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.3.04</span><span>Aprobación Cimentar</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.3.24</span><span><strong>Resultado:</strong> Gate 1 firmado el 17/11/2026</span><span><strong>Responsable:</strong> Gerencia</span></div>
            </div>
          </div>
        </div>

        <div class="branch branch-purple">
          <div class="branch-conn"></div>
          <div class="cat-node cat-purple"><span class="cat-id">1.4</span><span class="cat-label">Integrar</span></div>
          <div class="child-conn"></div>
          <div class="pkg-list">
            <div class="pkg-header">Entregables</div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.4.01</span><span>Servidor y Odoo de prueba</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.4.1–1.4.4</span><span><strong>Resultado:</strong> Entorno instalado y configuración inicial verificada</span><span><strong>Responsable:</strong> Infraestructura</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.4.02</span><span>Roles y permisos</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.4.5–1.4.6</span><span><strong>Resultado:</strong> Perfiles por rol y pruebas de restricción</span><span><strong>Responsable:</strong> Analista / dueños</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.4.03</span><span>Catálogo y migración conciliados</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.4.7–1.4.11, 1.4.27</span><span><strong>Resultado:</strong> Catálogo homologado, datos de prueba conciliados y plan de corte</span><span><strong>Responsable:</strong> Dueños de datos / analista</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.4.04</span><span>Flujo operativo Odoo</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.4.12–1.4.19</span><span><strong>Resultado:</strong> Venta–stock–despacho, talleres y bloqueos probados</span><span><strong>Responsable:</strong> Analista / usuarios</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.4.05</span><span>Pruebas y aceptación Integrar</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.4.20–1.4.26, 1.4.28–1.4.29</span><span><strong>Resultado:</strong> UAT firmada, cero defectos críticos abiertos y Gate 2 del 08/03/2027</span><span><strong>Responsable:</strong> Usuarios / Gerencia</span></div>
            </div>
          </div>
        </div>

        <div class="branch branch-cyan">
          <div class="branch-conn"></div>
          <div class="cat-node cat-cyan"><span class="cat-id">1.5</span><span class="cat-label">Optimizar y cerrar</span></div>
          <div class="child-conn"></div>
          <div class="pkg-list">
            <div class="pkg-header">Entregables</div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.5.01</span><span>Reportes y controles de calidad</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.5.1–1.5.4, 1.5.16–1.5.17</span><span><strong>Resultado:</strong> KPIs y rentabilidad verificados en uso real</span><span><strong>Responsable:</strong> Gerencia / analista</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.5.02</span><span>Manuales y capacitación</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.5.5–1.5.9</span><span><strong>Resultado:</strong> Guías y formación por rol</span><span><strong>Responsable:</strong> Usuarios / líder</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.5.03</span><span>Salida a producción</span></div>
              <div class="pkg-meta"><span><strong>Actividades:</strong> 1.5.10–1.5.15</span><span><strong>Resultado:</strong> Corte conciliado, salida en vivo, piloto retirado y operación observada</span><span><strong>Responsable:</strong> Dueños / analista</span></div>
            </div>
            <div class="pkg-item">
              <div class="pkg-title"><span class="pid">EDT-1.5.04</span><span>Conformidad y cierre</span></div>
