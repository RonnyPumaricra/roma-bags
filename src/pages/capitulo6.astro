import Layout from '../layouts/Layout.astro';
---

<Layout title="Capítulo 06: Gestión del Alcance">
<style>
    .chapter-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0 2rem; align-items: center; }
    .chapter-toolbar .ct-btn { display: inline-flex; align-items: center; justify-content: center; padding: .8rem 1.1rem; border-radius: 999px; border: 1px solid rgba(15,23,42,.12); background: #fff; color: var(--b); font-weight: 700; text-decoration: none; box-shadow: 0 8px 22px rgba(15,23,42,.08); transition: transform .18s ease, background .18s ease, border-color .18s ease; }
    .chapter-toolbar .ct-btn:hover { transform: translateY(-1px); border-color: #2563eb; background: #eff6ff; }
    .chapter-toolbar .ct-btn-primary { background: linear-gradient(135deg,#1d4ed8,#2563eb); color: #fff; border-color: transparent; }
    .chapter-toolbar .ct-btn-primary:hover { background: linear-gradient(135deg,#1e40af,#1d4ed8); }
    .dic-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(300px,1fr)); gap: 1.2rem; margin-top: 1.6rem; counter-reset: dictionary-entry; }
    .dic-grid .dic-item { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; box-shadow: 0 16px 34px rgba(15,23,42,.08); padding: 1.35rem 1.35rem 25px; position: relative; counter-increment: dictionary-entry; height: auto; min-height: 100%; display: flex; flex-direction: column; }
    .dic-grid .dic-item::before { content: counter(dictionary-entry, decimal) "."; position: absolute; top: 1.25rem; right: 1.25rem; font-size: .95rem; font-weight: 800; color: #2563eb; background: rgba(59,130,246,.12); padding: .35rem .75rem; border-radius: 999px; }
    .dic-grid .dic-item h5 { margin: 0 0 .75rem; font-size: 1.02rem; color: #1d4ed8; letter-spacing: .02em; padding-right: 4rem; width: 100%; display: flex; align-items: center; justify-content: flex-start; }
    .dic-grid .dic-item p { margin: .45rem 0; line-height: 1.7; color: #334155; font-size: .94rem; }
    .dic-grid .dic-item p strong { color: #0f172a; }
    .dic-grid .dic-item .meta { display: grid; grid-template-columns: 1fr; gap: .4rem; margin: .8rem 0 0; font-size: .88rem; color: #475569; }
    .dic-grid .dic-item .meta span { display: inline-flex; align-items: center; gap: .4rem; background: #eef2ff; padding: .28rem .65rem; border-radius: 999px; border: 1px solid #dbeafe; }
    .dic-section-header { margin: 2rem 0 .9rem; padding: .95rem 1rem; border-radius: 16px; background: linear-gradient(135deg,#e0f2fe,#dbeafe); color: #1e3a8a; border: 1px solid #bae6fd; font-weight: 700; box-shadow: inset 0 1px 0 rgba(255,255,255,.8); }
    .dic-section-header span { display: inline-flex; align-items: center; gap: .5rem; }
    .dic-section-header small { display: block; font-size: .85rem; color: #475569; margin-top: .35rem; }
  </style>
<style>
    .new-table {width:100%;border-collapse:collapse;font-size:.86rem;min-width:740px}
    .new-table th,.new-table td{padding:.55rem .7rem;text-align:left;border-bottom:1px solid #e2e8f0;vertical-align:top}
    .new-table th{background:#e0e7ff;color:#1e3a8a;position:sticky;top:0}
    .new-scroll{overflow-x:auto;margin:1rem 0 1.5rem}
    .new-box{background:#fff;border:1px solid #dbeafe;border-radius:18px;padding:1.25rem;margin:1.1rem 0;box-shadow:0 10px 22px rgba(15,23,42,.06)}
    .new-note{background:#eff6ff;border-left:4px solid #2563eb;padding:1rem 1.2rem;border-radius:10px;margin:1.2rem 0}
    .new-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem}
    .new-card{background:#fff;border:1px solid #dbeafe;border-radius:16px;padding:1rem}
    .new-card h4{margin:.2rem 0 .5rem;color:#1e40af}
    .new-card p{margin:.4rem 0;line-height:1.6}
    .new-pill{display:inline-block;background:#faf5ff;color:#7e22ce;border-radius:7px;padding:.1rem .4rem;font-size:.78rem;font-weight:700}
    .new-meta{display:flex;flex-wrap:wrap;gap:1rem;color:#1e40af;font-weight:700}
  </style>
<h2>CAPÍTULO 06: Gestión del Alcance (Línea Base del Alcance)</h2><p>Proyecto: 21/09/2026–26/04/2027 · 149 días hábiles · Gates 17/11/2026, 08/03/2027 y 21/04/2027.</p>
<section class="sec" id="trazabilidad"><h3>6.0 Documentación de requisitos y trazabilidad</h3><p>La línea base responde a la gestión fragmentada de información operativa y comercial. La evidencia del Anexo 2.5 indica que 70,8 % de registros de despacho de 2026 carecen de información financiera o logística. Los requisitos se validan en el diagnóstico programado entre septiembre y octubre de 2026.</p><div class="new-scroll"><table class="new-table"><thead><tr><th>ID</th><th>Requisito</th><th>Causa</th><th>Paquete EDT</th><th>Actividades</th><th>Aceptación</th></tr></thead><tbody><tr><td>REQ-01</td><td>Fuente única de inventario y ventas</td><td>CI 1.1 / CI 1.2</td><td>EDT-1.3.03 / EDT-1.4.03</td><td>1.3.16, 1.3.21, 1.4.10, 1.5.13</td><td>Registro consistente y fuente oficial Odoo tras el corte.</td></tr><tr><td>REQ-02</td><td>Consulta móvil de stock</td><td>CI 1.1</td><td>EDT-1.3.03</td><td>1.3.18–1.3.19</td><td>Consulta cronometrada en menos de 2 minutos.</td></tr><tr><td>REQ-03</td><td>Conciliación semanal ágil</td><td>CI 2.1</td><td>EDT-1.4.04 / EDT-1.5.01</td><td>1.4.17–1.4.18, 1.5.16–1.5.17</td><td>Comparar tiempo real frente a línea base de 1 día semanal.</td></tr><tr><td>REQ-04</td><td>Despacho completo y trazable</td><td>CI 2.3 / ED 2</td><td>EDT-1.3.02 / EDT-1.4.04</td><td>1.3.10–1.3.11, 1.4.17–1.4.19</td><td>Registrar y verificar ventas, stock y despacho con casos UAT; tras la salida en vivo, reducir a 5 % o menos los registros incompletos de la muestra revisada.</td></tr><tr><td>REQ-05</td><td>Reportes móviles de stock, calidad de datos y rentabilidad operativa</td><td>CI 3.1 / ED 3</td><td>EDT-1.5.01</td><td>1.5.1–1.5.4, 1.5.16</td><td>Gerencia valida cifras, fuentes y acceso por rol.</td></tr><tr><td>REQ-06</td><td>Operación en celulares y dos talleres</td><td>CI 1.2</td><td>EDT-1.3.01 / EDT-1.4.04</td><td>1.3.4, 1.4.14–1.4.15, 1.4.21</td><td>Pruebas de conectividad y flujo por ubicación.</td></tr><tr><td>REQ-07</td><td>Coexistencia controlada y corte del piloto</td><td>CI 2.2</td><td>EDT-1.3.03 / EDT-1.5.03</td><td>1.3.20, 1.5.11–1.5.13</td><td>Un responsable de fuente oficial; piloto bloqueado tras salida.</td></tr><tr><td>REQ-08</td><td>Respaldo, seguridad y permisos</td><td>CI 2.2</td><td>EDT-1.3.02 / EDT-1.4.02</td><td>1.3.12–1.3.13, 1.4.5–1.4.6</td><td>Respaldo verificable y acceso probado por rol.</td></tr><tr><td>REQ-09</td><td>Datos depurados, conciliados y preservados</td><td>CI 3.2</td><td>EDT-1.3.02 / EDT-1.4.03</td><td>1.3.14–1.3.15, 1.4.8–1.4.11</td><td>Conteos y saldos conciliados; preservar originales de 2026.</td></tr><tr><td>REQ-10</td><td>Adopción y transferencia de control</td><td>CI 2.3 / CI 3.1</td><td>EDT-1.5.02 / EDT-1.5.04</td><td>1.5.5–1.5.9, 1.5.15–1.5.22</td><td>Capacitación por rol, evidencias de uso y responsables firmados.</td></tr></tbody></table></div><div class="new-note">Los códigos <strong>EDT-</strong> identifican entregables; los códigos 1.1.1–1.5.23 identifican actividades del cronograma. La matriz mantiene ambos separados.</div></section>
<section class="sec" id="definir"><h3>6.1 Enunciado del alcance</h3><div class="new-grid"><div class="new-card"><h4>Incluido</h4><p>Diagnóstico AS-IS/TO-BE, conectividad, base piloto temporal, gobierno y limpieza de datos, Odoo Community para inventario/ventas/despachos, conciliación y migración, pruebas por rol, reportes gerenciales, capacitación, salida a producción, monitoreo y transferencia al Comité de Datos.</p></div><div class="new-card"><h4>Excluido</h4><p>Recuperación de registros perdidos del 2024, contabilidad formal, facturación electrónica, integración SUNAT, e-commerce, automatización de maquinaria y mantenimiento evolutivo posterior al cierre.</p></div></div><h4>Criterios de aceptación por gate</h4><div class="new-grid"><div class="new-card"><h4>Gate 1 · 17/11/2026</h4><p>Conectividad verificada; comité y responsables designados; diccionario, SOP y respaldo aprobados; catálogo depurado; captura piloto y consulta móvil comprobadas; coexistencia con Excel documentada.</p></div><div class="new-card"><h4>Gate 2 · 08/03/2027</h4><p>Odoo en pruebas con datos conciliados, flujo y permisos verificados, UAT firmadas por Ventas, Producción y Gerencia, sin defectos críticos abiertos y plan de corte aprobado.</p></div><div class="new-card"><h4>Gate 3 · 21/04/2027</h4><p>Odoo como fuente oficial, monitoreo y auditoría de calidad, reportes en uso real, capacitación, criterios de aceptación e informe final verificados; conformidad firmada. Archivo administrativo: 26/04/2027.</p></div></div></section>
<section class="sec" id="edt"><h3>6.2 Estructura de Desglose del Trabajo (EDT)</h3><p>La EDT se organiza por <strong>entregables</strong>, no por cada acción del cronograma. Sus cinco ramas son 1.1 Dirección y planificación, 1.2 Diagnóstico AS-IS/TO-BE, 1.3 Cimentar, 1.4 Integrar y 1.5 Optimizar y cerrar. Los paquetes siguientes cubren las 92 actividades e hitos y permiten comprobar la regla del 100 %.</p><div class="new-scroll"><table class="new-table"><thead><tr><th>Paquete</th><th>Entregable</th><th>Actividades</th><th>Resultado verificable</th><th>Responsable</th></tr></thead><tbody><tr><td><strong>EDT-1.1.01</strong></td><td>Dirección y líneas base</td><td>1.1.1–1.1.4</td><td>Acta firmada, responsables y planes aprobados</td><td>Patrocinador / líder</td></tr><tr><td><strong>EDT-1.1.02</strong></td><td>Seguimiento y control</td><td>1.1.5–1.1.7</td><td>Informes, registro de cambios y seguimiento documentado</td><td>Líder</td></tr><tr><td><strong>EDT-1.2.01</strong></td><td>Diagnóstico AS-IS</td><td>1.2.1–1.2.5</td><td>Flujo actual y fuentes auditadas</td><td>Analista / Gerencia</td></tr><tr><td><strong>EDT-1.2.02</strong></td><td>Diseño TO-BE y requisitos</td><td>1.2.6–1.2.9</td><td>Requisitos REQ-01–10 y trazabilidad firmada</td><td>Analista / responsables</td></tr><tr><td><strong>EDT-1.3.01</strong></td><td>Conectividad operativa</td><td>1.3.1–1.3.4</td><td>Red y respaldo móvil probados en talleres</td><td>Infraestructura</td></tr><tr><td><strong>EDT-1.3.02</strong></td><td>Gobierno inicial y calidad</td><td>1.3.5–1.3.7, 1.3.10–1.3.15</td><td>Comité, dueños, diccionario, SOP, respaldo y catálogo depurado</td><td>Gerencia / dueños de datos</td></tr><tr><td><strong>EDT-1.3.03</strong></td><td>Piloto centralizado controlado</td><td>1.3.8–1.3.9, 1.3.16–1.3.23</td><td>Modelo mapeado, captura, stock móvil y coexistencia trazable</td><td>Analista / usuarios</td></tr><tr><td><strong>EDT-1.3.04</strong></td><td>Aprobación Cimentar</td><td>1.3.24</td><td>Gate 1 firmado el 17/11/2026</td><td>Gerencia</td></tr><tr><td><strong>EDT-1.4.01</strong></td><td>Servidor y Odoo de prueba</td><td>1.4.1–1.4.4</td><td>Entorno instalado y configuración inicial verificada</td><td>Infraestructura</td></tr><tr><td><strong>EDT-1.4.02</strong></td><td>Roles y permisos</td><td>1.4.5–1.4.6</td><td>Perfiles por rol y pruebas de restricción</td><td>Analista / dueños</td></tr><tr><td><strong>EDT-1.4.03</strong></td><td>Catálogo y migración conciliados</td><td>1.4.7–1.4.11, 1.4.27</td><td>Catálogo homologado, datos de prueba conciliados y plan de corte</td><td>Dueños de datos / analista</td></tr><tr><td><strong>EDT-1.4.04</strong></td><td>Flujo operativo Odoo</td><td>1.4.12–1.4.19</td><td>Venta–stock–despacho, talleres y bloqueos probados</td><td>Analista / usuarios</td></tr><tr><td><strong>EDT-1.4.05</strong></td><td>Pruebas y aceptación Integrar</td><td>1.4.20–1.4.26, 1.4.28–1.4.29</td><td>UAT firmada, cero defectos críticos abiertos y Gate 2 del 08/03/2027</td><td>Usuarios / Gerencia</td></tr><tr><td><strong>EDT-1.5.01</strong></td><td>Reportes y controles de calidad</td><td>1.5.1–1.5.4, 1.5.16–1.5.17</td><td>KPIs y rentabilidad verificados en uso real</td><td>Gerencia / analista</td></tr><tr><td><strong>EDT-1.5.02</strong></td><td>Manuales y capacitación</td><td>1.5.5–1.5.9</td><td>Guías y formación por rol</td><td>Usuarios / líder</td></tr><tr><td><strong>EDT-1.5.03</strong></td><td>Salida a producción</td><td>1.5.10–1.5.15</td><td>Corte conciliado, salida en vivo, piloto retirado y operación observada</td><td>Dueños / analista</td></tr><tr><td><strong>EDT-1.5.04</strong></td><td>Conformidad y cierre</td><td>1.5.18–1.5.23</td><td>Comité recibe control, expediente, Gate 3 el 21/04 y archivo el 26/04</td><td>Gerencia / líder</td></tr></tbody></table></div><p>El paquete 1.5 de documentación comienza con manuales durante las pruebas de Integrar; ese solapamiento está previsto en el cronograma. Las actividades transversales de 1.1 se atienden periódicamente y no equivalen a dedicación completa durante todos los días hábiles de sus ventanas.</p></section>
<section class="sec" id="diccionario"><h3>6.3 Diccionario de la EDT</h3><p>Para cada paquete se indica el resultado comprobable, la persona que valida y el conjunto de actividades que lo produce. Los detalles operativos de fechas y predecesoras figuran en el capítulo 7.</p><div class="new-grid"><div class="new-card"><h4>EDT-1.1.01 · Dirección y líneas base</h4><p><strong>Actividades vinculadas:</strong> 1.1.1–1.1.4</p><p><strong>Entregable y aceptación:</strong> Acta firmada, responsables y planes aprobados.</p><p><strong>Responsable:</strong> Patrocinador / líder.</p></div><div class="new-card"><h4>EDT-1.1.02 · Seguimiento y control</h4><p><strong>Actividades vinculadas:</strong> 1.1.5–1.1.7</p><p><strong>Entregable y aceptación:</strong> Informes, registro de cambios y seguimiento documentado.</p><p><strong>Responsable:</strong> Líder.</p></div><div class="new-card"><h4>EDT-1.2.01 · Diagnóstico AS-IS</h4><p><strong>Actividades vinculadas:</strong> 1.2.1–1.2.5</p><p><strong>Entregable y aceptación:</strong> Flujo actual y fuentes auditadas.</p><p><strong>Responsable:</strong> Analista / Gerencia.</p></div><div class="new-card"><h4>EDT-1.2.02 · Diseño TO-BE y requisitos</h4><p><strong>Actividades vinculadas:</strong> 1.2.6–1.2.9</p><p><strong>Entregable y aceptación:</strong> Requisitos REQ-01–10 y trazabilidad firmada.</p><p><strong>Responsable:</strong> Analista / responsables.</p></div><div class="new-card"><h4>EDT-1.3.01 · Conectividad operativa</h4><p><strong>Actividades vinculadas:</strong> 1.3.1–1.3.4</p><p><strong>Entregable y aceptación:</strong> Red y respaldo móvil probados en talleres.</p><p><strong>Responsable:</strong> Infraestructura.</p></div><div class="new-card"><h4>EDT-1.3.02 · Gobierno inicial y calidad</h4><p><strong>Actividades vinculadas:</strong> 1.3.5–1.3.7, 1.3.10–1.3.15</p><p><strong>Entregable y aceptación:</strong> Comité, dueños, diccionario, SOP, respaldo y catálogo depurado.</p><p><strong>Responsable:</strong> Gerencia / dueños de datos.</p></div><div class="new-card"><h4>EDT-1.3.03 · Piloto centralizado controlado</h4><p><strong>Actividades vinculadas:</strong> 1.3.8–1.3.9, 1.3.16–1.3.23</p><p><strong>Entregable y aceptación:</strong> Modelo mapeado, captura, stock móvil y coexistencia trazable.</p><p><strong>Responsable:</strong> Analista / usuarios.</p></div><div class="new-card"><h4>EDT-1.3.04 · Aprobación Cimentar</h4><p><strong>Actividades vinculadas:</strong> 1.3.24</p><p><strong>Entregable y aceptación:</strong> Gate 1 firmado el 17/11/2026.</p><p><strong>Responsable:</strong> Gerencia.</p></div><div class="new-card"><h4>EDT-1.4.01 · Servidor y Odoo de prueba</h4><p><strong>Actividades vinculadas:</strong> 1.4.1–1.4.4</p><p><strong>Entregable y aceptación:</strong> Entorno instalado y configuración inicial verificada.</p><p><strong>Responsable:</strong> Infraestructura.</p></div><div class="new-card"><h4>EDT-1.4.02 · Roles y permisos</h4><p><strong>Actividades vinculadas:</strong> 1.4.5–1.4.6</p><p><strong>Entregable y aceptación:</strong> Perfiles por rol y pruebas de restricción.</p><p><strong>Responsable:</strong> Analista / dueños.</p></div><div class="new-card"><h4>EDT-1.4.03 · Catálogo y migración conciliados</h4><p><strong>Actividades vinculadas:</strong> 1.4.7–1.4.11, 1.4.27</p><p><strong>Entregable y aceptación:</strong> Catálogo homologado, datos de prueba conciliados y plan de corte.</p><p><strong>Responsable:</strong> Dueños de datos / analista.</p></div><div class="new-card"><h4>EDT-1.4.04 · Flujo operativo Odoo</h4><p><strong>Actividades vinculadas:</strong> 1.4.12–1.4.19</p><p><strong>Entregable y aceptación:</strong> Venta–stock–despacho, talleres y bloqueos probados.</p><p><strong>Responsable:</strong> Analista / usuarios.</p></div><div class="new-card"><h4>EDT-1.4.05 · Pruebas y aceptación Integrar</h4><p><strong>Actividades vinculadas:</strong> 1.4.20–1.4.26, 1.4.28–1.4.29</p><p><strong>Entregable y aceptación:</strong> UAT firmada, cero defectos críticos abiertos y Gate 2 del 08/03/2027.</p><p><strong>Responsable:</strong> Usuarios / Gerencia.</p></div><div class="new-card"><h4>EDT-1.5.01 · Reportes y controles de calidad</h4><p><strong>Actividades vinculadas:</strong> 1.5.1–1.5.4, 1.5.16–1.5.17</p><p><strong>Entregable y aceptación:</strong> KPIs y rentabilidad verificados en uso real.</p><p><strong>Responsable:</strong> Gerencia / analista.</p></div><div class="new-card"><h4>EDT-1.5.02 · Manuales y capacitación</h4><p><strong>Actividades vinculadas:</strong> 1.5.5–1.5.9</p><p><strong>Entregable y aceptación:</strong> Guías y formación por rol.</p><p><strong>Responsable:</strong> Usuarios / líder.</p></div><div class="new-card"><h4>EDT-1.5.03 · Salida a producción</h4><p><strong>Actividades vinculadas:</strong> 1.5.10–1.5.15</p><p><strong>Entregable y aceptación:</strong> Corte conciliado, salida en vivo, piloto retirado y operación observada.</p><p><strong>Responsable:</strong> Dueños / analista.</p></div><div class="new-card"><h4>EDT-1.5.04 · Conformidad y cierre</h4><p><strong>Actividades vinculadas:</strong> 1.5.18–1.5.23</p><p><strong>Entregable y aceptación:</strong> Comité recibe control, expediente, Gate 3 el 21/04 y archivo el 26/04.</p><p><strong>Responsable:</strong> Gerencia / líder.</p></div></div></section>
</Layout>
