<style>
  /* ── GANTT WRAPPER ── */
  .gantt-outer { overflow-x: auto; margin: 0; border-radius: 20px; box-shadow: 0 24px 52px rgba(15,23,42,.12); background: #fff; border: 1px solid #dbeafe; }

  /* ── META INFO CARD ── */
  .gantt-meta {
    position: sticky;
    left: 0;
    display: grid; gap: .85rem; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); padding: 1.4rem 1.6rem 1.2rem; background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%); border-bottom: 1px solid #dbeafe; border-radius: 20px 20px 0 0;
  }
  .gantt-meta-item { text-align: center; }
  .gantt-meta-item .gm-label { display: block; font-size: .7rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .3rem; }
  .gantt-meta-item .gm-value { display: block; font-size: 1rem; font-weight: 700; color: #0f172a; }
  .gantt-meta-item .gm-value.accent { color: #1d4ed8; font-size: 1.15rem; }

  /* ── GANTT TABLE ── */
  .gantt-table { width: 100%; min-width: 1710px; border-collapse: collapse; font-size: .84rem; }
  .gantt-table thead th { background: #1e3a8a; color: #fff; font-weight: 700; padding: .55rem .7rem; text-align: left; white-space: nowrap; position: sticky; top: 0; z-index: 2; }
  .gantt-table thead th:nth-child(1) { width: 36px; }
  .gantt-table thead th:nth-child(2) { min-width: 280px; }
  .gantt-table thead th:nth-child(3), .gantt-table thead th:nth-child(4), .gantt-table thead th:nth-child(5), .gantt-table thead th:nth-child(6) { width: 92px; }
  .gantt-table thead th:last-child { min-width: 1120px; }

  .gantt-table tbody tr { border-bottom: 1px solid #f1f5f9; transition: background .12s; }
  .gantt-table tbody tr:hover { background: #f8fbff; }

  /* Row types */
  .row-project   { background: #1e3a8a !important; color: #fff !important; font-weight: 800; }
  .row-phase     { background: #dbeafe !important; color: #1e3a8a !important; font-weight: 700; }
  .row-summary   { background: #eff6ff !important; color: #1e40af !important; font-weight: 600; font-style: italic; }
  .row-milestone { background: #fefce8 !important; color: #854d0e !important; font-weight: 700; }
  .row-parallel  { background: #f0fdf4 !important; color: #166534 !important; }
  .row-task      { color: #334155; }
  .row-governance { color: #6b21a8; }
  .row-continuous { color: #475569; }

  .gantt-table td { padding: .42rem .7rem; white-space: nowrap; vertical-align: middle; }
  .gantt-table td:nth-child(1) { text-align: center; font-weight: 700; color: #64748b; font-size: .8rem; }
  .row-project td, .row-phase td, .row-milestone td { color: inherit !important; }

  /* Task name indent */
  .t-name { white-space: normal; line-height: 1.35; }
  .t-name.indent-1 { padding-left: 1rem; }
  .t-name.indent-2 { padding-left: 2rem; }
  .t-name.indent-3 { padding-left: 3rem; }
  .t-parallel-badge { display: inline-block; font-size: .68rem; background: #dcfce7; color: #166534; border-radius: 4px; padding: .1rem .4rem; margin-left: .35rem; font-weight: 700; vertical-align: middle; }
  .t-milestone-icon { display: inline-block; margin-right: .35rem; }

  /* ── GANTT BAR CHART AREA ── */
  .bar-cell { padding: .3rem .5rem; }
  .gantt-bar-row { position: relative; height: 18px; background: transparent; }
  .gantt-bar { position: absolute; top: 1px; height: 16px; border-radius: 5px; opacity: .92; }
  /* Bar colors by type */
  .bar-project   { background: linear-gradient(90deg, #1d4ed8, #2563eb); }
  .bar-phase     { background: linear-gradient(90deg, #60a5fa, #93c5fd); }
  .bar-phase2    { background: linear-gradient(90deg, #34d399, #6ee7b7); }
  .bar-phase3    { background: linear-gradient(90deg, #a78bfa, #c4b5fd); }
  .bar-task      { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
  .bar-parallel  { background: linear-gradient(90deg, #10b981, #34d399); }
  .bar-milestone { background: #eab308; width: 12px !important; transform: rotate(45deg); border-radius: 2px; top: 3px; height: 12px; }

  .bar-governance { background: linear-gradient(90deg,#9333ea,#c084fc); }
  .bar-continuous { background: repeating-linear-gradient(90deg,#64748b 0 10px,#cbd5e1 10px 15px); }
  .gantt-bar-row { min-width: 1120px; background: repeating-linear-gradient(90deg,#f8fafc 0,#f8fafc calc(100% / 149 * 5 - 1px),#dbeafe calc(100% / 149 * 5 - 1px),#dbeafe calc(100% / 149 * 5)); }
  .gantt-bar { z-index: 1; }
  .gantt-bar-row .bar-milestone { margin-left: -6px; }
  .gantt-notes { padding: .7rem 1.4rem; background: #fff; color: #475569; font-size: .78rem; line-height: 1.5; }
  .gantt-notes p { margin: .25rem 0; }
  .week-header td { position: sticky; top: 36px; z-index: 2; }
  .week-track { display: flex; min-width: 1120px; }
  .week-track span { box-sizing: border-box; overflow: hidden; border-right: 1px solid #c7d2fe; text-align: center; white-space: nowrap; }
  /* Timeline legend */
  .gantt-legend { display: flex; flex-wrap: wrap; gap: .75rem; padding: .9rem 1.4rem; border-top: 1px solid #e2e8f0; background: #f8fbff; border-radius: 0 0 20px 20px; font-size: .78rem; }
  .gantt-legend-item { display: flex; align-items: center; gap: .35rem; }
  .gantt-legend-swatch { width: 24px; height: 10px; border-radius: 3px; }

  /* Semanas header row */
  .week-header td { background: #e0e7ff; font-size: .72rem; font-weight: 700; color: #3730a3; text-align: center; padding: .3rem .2rem; border-right: 1px solid #c7d2fe; }

  /* Phase separator */
  .phase-sep td { border-top: 2px solid #93c5fd; }

  td:nth-child(3), 
  td:nth-child(4), 
  td:nth-child(5), 
  td:nth-child(6) {
    min-width: 5rem;
    max-width: 5rem;
  } 
</style>

